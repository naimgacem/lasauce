# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env / secrets — ignore real env files, keep every *.example template.
# `.env.*` also matches `.env.local.example`, so the negations must cover the
# `*.example` suffix generally, not just the literal `.env.example`.
.env
.env.*
**/.env
**/.env.*
!*.example
!**/*.example

# Media / uploads (local storage backend)
backend/media/
media/

# Node / frontend (added in later milestones)
node_modules/
.next/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
