# Copy to .env.local

# Leave EMPTY. The browser calls /api/v1 on this origin and Next proxies it to
# API_ORIGIN, so the app works under localhost, a LAN IP or a tunnel URL with no
# rebuild. Putting a host here bakes it into the bundle at build time — then a
# friend on another laptop calls THEIR machine and everything fails.
NEXT_PUBLIC_API_URL=

# Where the Next server forwards /api/v1/* and /media/* (server-side, runtime).
API_ORIGIN=http://localhost:8000
MEDIA_ORIGIN=http://localhost:8000

# Leave EMPTY. Item photos are served same-origin as /media/*, proxied to the
# API by the rewrite in next.config.mjs (point MEDIA_ORIGIN elsewhere to move
# storage). Setting a host here makes next/image treat them as remote images,
# which needs a remotePatterns entry and breaks optimisation inside Docker.
NEXT_PUBLIC_MEDIA_URL=

# "true" = serve in-memory mock data (full app demoable without a backend).
NEXT_PUBLIC_USE_MOCKS=true

# Feature flags (future milestones).
NEXT_PUBLIC_FEATURE_MATCHES=false
NEXT_PUBLIC_FEATURE_ADMIN=false
