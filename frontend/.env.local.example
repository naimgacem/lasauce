# Copy to .env.local

# FastAPI backend base URL (includes /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Leave EMPTY. Item photos are served same-origin as /media/*, proxied to the
# API by the rewrite in next.config.mjs (point MEDIA_ORIGIN elsewhere to move
# storage). Setting a host here makes next/image treat them as remote images,
# which needs a remotePatterns entry and breaks optimisation inside Docker.
NEXT_PUBLIC_MEDIA_URL=

# "true" = serve in-memory mock data (full app demoable without a backend).
NEXT_PUBLIC_USE_MOCKS=true

# Feature flags (future milestones).
NEXT_PUBLIC_FEATURE_MATCHES=false
NEXT_PUBLIC_FEATURE_ADMIN=false
