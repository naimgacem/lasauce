# Copy to `deploy/.env` on the server and fill in the three REQUIRED values.
# `deploy/.env` holds secrets: it is git-ignored, never commit it.

# --- REQUIRED ---------------------------------------------------------------

# The public hostname, without https://.
#   * Own domain:  sabtou.example.com  (DNS A record -> the server's IP)
#   * No domain:   the server IP with dashes + .sslip.io, e.g. for 141.147.20.5
#                  use 141-147-20-5.sslip.io — free, works immediately, and
#                  gets a real HTTPS certificate like any domain.
DOMAIN=

# Database password. Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs every login session. Generate with:  openssl rand -hex 32
# The API refuses to start with a missing or short value.
JWT_SECRET_KEY=

# --- Mode ---------------------------------------------------------------------

# `staging` keeps the "simulate payment" button working, so the full paid-match
# flow can be demonstrated with no payment gateway and no money involved.
# Switch to `production` together with PAYMENT_PROVIDER=chargily for real
# payments — production refuses simulated ones.
APP_ENV=staging

# --- Paid matching ----------------------------------------------------------------

MATCHING_PAYWALL_ENABLED=true
FREE_MATCH_UNLOCKS=1
MATCH_UNLOCK_COST=1

# manual (demo, no gateway) | chargily (real payments)
PAYMENT_PROVIDER=manual
# Test: https://pay.chargily.net/test/api/v2   Live: https://pay.chargily.net/api/v2
CHARGILY_API_BASE=https://pay.chargily.net/test/api/v2
CHARGILY_SECRET_KEY=

# --- Optional -----------------------------------------------------------------------

POSTGRES_USER=sabtou
POSTGRES_DB=sabtou
LOG_LEVEL=INFO
# Change only to rehearse the stack on a machine where 80/443 are taken.
HTTP_PORT=80
HTTPS_PORT=443
